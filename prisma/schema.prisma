generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserTier {
  FREE
  PRO
  ENTERPRISE
}

enum ContentStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentType {
  VIDEO
  AUDIO
  TEXT
  NEWSLETTER
  SOCIAL
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String?
  image             String?
  role              UserRole  @default(USER)
  tier              UserTier  @default(FREE)
  emailVerified     DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?

  preferences       Json      @default("{}")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLogin         DateTime?

  accounts          Account[]
  sessions          Session[]
  contents          Content[]
  workflows         Workflow[]
  apiUsage          ApiUsage[]
  templates         Template[]
  newsletters       Newsletter[]
  teamMemberships   TeamMember[]
  reviewsCreated    ReviewQueue[]  @relation("ReviewQueueUser")
  reviewsAssigned   ReviewQueue[]  @relation("ReviewQueueReviewer")
  feedbacks         Feedback[]

  @@index([email])
  @@index([tier])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Content {
  id            String        @id @default(cuid())
  userId        String
  type          ContentType
  title         String
  description   String?
  script        String?       @db.Text
  avatar        String?
  voice         String?
  workflow      Json?
  integrations  String[]
  duration      Int?
  tokensSaved   Int           @default(0)
  outputUrl     String?
  thumbnailUrl  String?
  status        ContentStatus @default(DRAFT)
  metadata      Json          @default("{}")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  publishedAt       DateTime?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews           ReviewQueue[]
  shadowPredictions ShadowPrediction[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Workflow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  steps       Json
  triggers    Json?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastRun     DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Template {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
  category    String
  type        ContentType
  config      Json
  thumbnail   String?
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublic])
  @@index([usageCount])
}

model Newsletter {
  id            String   @id @default(cuid())
  userId        String
  title         String
  subject       String
  content       String   @db.Text
  beehiivId     String?
  status        String   @default("draft")
  scheduledAt   DateTime?
  sentAt        DateTime?

  opens         Int      @default(0)
  clicks        Int      @default(0)
  subscribers   Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ApiUsage {
  id          String   @id @default(cuid())
  userId      String
  service     String
  endpoint    String
  tokens      Int      @default(0)
  cost        Float    @default(0)
  latency     Int      @default(0)
  status      String

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([service])
  @@index([createdAt])
}

model ApiEndpoint {
  id          String   @id @default(cuid())
  method      String
  path        String
  description String?
  hits        Int      @default(0)
  avgLatency  Float    @default(0)
  status      String   @default("healthy")
  lastHit     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([method, path])
  @@index([status])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  image       String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]

  @@index([slug])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member")

  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model SystemMetrics {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  activeUsers     Int      @default(0)
  totalRequests   Int      @default(0)
  avgResponseTime Float    @default(0)
  errorRate       Float    @default(0)
  cpuUsage        Float    @default(0)
  memoryUsage     Float    @default(0)

  @@index([timestamp])
}

// ==========================================
// AI MVP / HITL (Human-in-the-Loop) Models
// ==========================================

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

enum ReviewPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ReviewQueue {
  id              String         @id @default(cuid())
  contentId       String
  userId          String
  reviewerId      String?

  // AI Output Data
  aiOutput        String         @db.Text
  aiModel         String
  confidenceScore Float

  // Review Metadata
  status          ReviewStatus   @default(PENDING)
  priority        ReviewPriority @default(MEDIUM)
  reason          String?
  category        String?

  // Review Results
  humanFeedback   String?        @db.Text
  corrections     Json?
  approved        Boolean?

  // Timing
  createdAt       DateTime       @default(now())
  assignedAt      DateTime?
  reviewedAt      DateTime?

  // Relations
  content         Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user            User           @relation("ReviewQueueUser", fields: [userId], references: [id])
  reviewer        User?          @relation("ReviewQueueReviewer", fields: [reviewerId], references: [id])
  feedbackItems   Feedback[]

  @@index([status])
  @@index([priority])
  @@index([confidenceScore])
  @@index([createdAt])
  @@index([reviewerId])
}

model Feedback {
  id              String       @id @default(cuid())
  reviewQueueId   String?
  contentId       String?
  userId          String

  // Feedback Data
  type            String       // 'correction', 'rating', 'suggestion', 'report'
  category        String?      // 'accuracy', 'tone', 'grammar', 'relevance', 'safety'
  rating          Int?         // 1-5 scale
  comment         String?      @db.Text

  // Original vs Corrected
  originalOutput  String?      @db.Text
  correctedOutput String?      @db.Text

  // Training Metadata
  usedForTraining Boolean      @default(false)
  trainingBatchId String?

  createdAt       DateTime     @default(now())

  // Relations
  reviewQueue     ReviewQueue? @relation(fields: [reviewQueueId], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([category])
  @@index([usedForTraining])
  @@index([createdAt])
}

model ModelMetrics {
  id                  String   @id @default(cuid())
  modelId             String
  modelVersion        String
  timestamp           DateTime @default(now())

  // Performance Metrics
  totalPredictions    Int      @default(0)
  approvedPredictions Int      @default(0)
  rejectedPredictions Int      @default(0)
  escalatedPredictions Int     @default(0)

  // Quality Metrics
  avgConfidenceScore  Float    @default(0)
  avgHumanRating      Float    @default(0)
  accuracyRate        Float    @default(0)

  // Latency Metrics
  avgLatency          Float    @default(0)
  p95Latency          Float    @default(0)
  p99Latency          Float    @default(0)

  // Drift Detection
  driftScore          Float    @default(0)
  driftDetected       Boolean  @default(false)

  // Cost Metrics
  totalTokens         Int      @default(0)
  estimatedCost       Float    @default(0)

  @@unique([modelId, modelVersion, timestamp])
  @@index([modelId])
  @@index([timestamp])
  @@index([driftDetected])
}

model ShadowPrediction {
  id                String   @id @default(cuid())
  contentId         String

  // Primary Model Output
  primaryModel      String
  primaryOutput     String   @db.Text
  primaryConfidence Float
  primaryLatency    Int

  // Shadow Model Output
  shadowModel       String
  shadowOutput      String   @db.Text
  shadowConfidence  Float
  shadowLatency     Int

  // Comparison Results
  outputSimilarity  Float
  confidenceDelta   Float
  latencyDelta      Int
  discrepancyFlag   Boolean  @default(false)

  createdAt         DateTime @default(now())

  content           Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([primaryModel])
  @@index([shadowModel])
  @@index([discrepancyFlag])
  @@index([createdAt])
}

model VectorEmbedding {
  id              String   @id @default(cuid())
  contentId       String?
  sourceType      String   // 'content', 'template', 'feedback', 'document'
  sourceId        String

  // Embedding Data
  embeddingModel  String
  dimensions      Int
  vectorId        String   // External vector DB ID (Pinecone, Weaviate)

  // Metadata
  metadata        Json     @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
  @@index([vectorId])
}

model ActiveLearningQueue {
  id              String   @id @default(cuid())
  feedbackId      String

  // Sample Data
  inputData       String   @db.Text
  outputData      String   @db.Text
  correctedData   String?  @db.Text

  // Selection Criteria
  uncertaintyScore Float
  diversityScore   Float
  priorityScore    Float

  // Processing Status
  status          String   @default("pending") // pending, selected, processed, discarded
  batchId         String?

  createdAt       DateTime @default(now())
  processedAt     DateTime?

  @@index([status])
  @@index([priorityScore])
  @@index([createdAt])
}
