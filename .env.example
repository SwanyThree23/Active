# SwanyThree Ultimate - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
DB_PASSWORD=your_secure_database_password_here

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ===========================================
# AI SERVICES
# ===========================================
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs (Voice Generation)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# HeyGen (Avatar Video)
HEYGEN_API_KEY=your_heygen_key_here

# OpenAI (Optional, for GPT models)
OPENAI_API_KEY=sk-your-openai-key-here

# ===========================================
# N8N WORKFLOW AUTOMATION
# ===========================================
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_here
N8N_HOST=localhost

# ===========================================
# STREAMING PLATFORMS
# ===========================================
# Twitch
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ===========================================
# MCP SERVER
# ===========================================
MCP_API_KEY=your_mcp_api_key_for_auth

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Suno (Music Generation)
SUNO_API_KEY=your_suno_key_here

# Transistor.fm (Podcast Hosting)
TRANSISTOR_API_KEY=your_transistor_key_here

# OBS WebSocket (default: localhost:4455)
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=your_obs_password

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
NODE_ENV=production
LOG_LEVEL=info
